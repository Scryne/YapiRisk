{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "vitest/valid-expect": ["warn", { "maxArgs": 2 }],
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "cn",
            "message": "@/lib/utils içindeki cn'i kullan: DESIGN.md yazı token'ları orada tanıtılı. shadcn add sonrası importu düzelt."
          }
        ]
      }
    ]
  },
  "overrides": [{ "files": ["src/components/ui/**"], "rules": { "react/only-export-components": "off" } }],
  "ignorePatterns": ["dist", "playwright-report", "test-results"]
}
